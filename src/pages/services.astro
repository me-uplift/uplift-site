---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { BLOOM_FORM_URL } from '../lib/links.js';

const title = 'Services and Pricing | Uplift Digital Studio';
const description = 'Flat monthly rates for social media management, UGC creator campaigns, web and SEO, and the Studio Pass, your fractional digital team.';

const fit = [
  { label: 'Need a professional on call?', line: 'Studio Pass', href: '#pass' },
  { label: 'Want to grow on social media?', line: 'Social media', href: '#social' },
  { label: 'Running social media ads?', line: 'UGC creators', href: '#campaigns' },
  { label: 'Need to be found online?', line: 'Web and SEO', href: '#web' },
];

// Decorative requests portal in the Studio Pass panel
const portalRows = [
  { title: 'Landing page for a launch', status: 'In progress', tone: 'progress' },
  { title: 'October newsletters', status: 'Queued', tone: 'queued' },
  { title: 'SEO blog post', status: 'Queued', tone: 'queued' },
  { title: 'Creator campaign brief', status: 'Delivered', tone: 'delivered' },
];

const passIncludes = [
  'Social, email, web, SEO, and UGC',
  'Requests worked in priority order',
  '1-2 day average turnaround',
  'Creator sourcing, up to 2 creators per month',
  'Strategy, copywriting, and campaign planning',
  'Operations and project management as needed',
  "No long-term commitment, cancel with 30 days' notice",
];

const plans = [
  { name: 'Essentials', price: '$600', features: ['9 posts and 9 stories', '1 platform', 'Caption writing'] },
  { name: 'Growth', price: '$800', featured: true, features: ['16 posts and 16 stories', '2 platforms', 'Comment-triggered DM automation'] },
  { name: 'Full Digital', price: '$1,100', features: ['20 posts and 20 stories', 'Live engagement management', 'Priority communication'] },
];

const ugcSteps = [
  { title: 'Brief', desc: 'Share your goal, audience, and offer. We write the creative brief.' },
  { title: 'Match', desc: 'We select vetted creators who fit your brand and your market.' },
  { title: 'Create', desc: 'We manage scripts, timelines, and one revision round per video so you never chase anyone.' },
  { title: 'Deliver', desc: 'You receive final files with usage rights and a performance summary.' },
];

const webRows = [
  { title: 'SEO', desc: 'Keyword strategy, SEO blog posts, and on-page optimization.', tag: 'Included in the Studio Pass', icon: 'search' },
  { title: 'Landing pages', desc: 'Single pages built to convert for campaigns and launches.', tag: 'Included in the Studio Pass', icon: 'layout' },
  { title: 'Website builds', desc: 'Full websites from strategy and copy to design and launch.', tag: 'Custom quote', dark: true, icon: 'globe' },
];

// Icon paths for the Web and SEO rows
const webIcons = {
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
};

const faqs = [
  { q: 'What does the Studio Pass cover?', a: 'Social, email, web, SEO, UGC, strategy, copywriting, and operations. Typical usage is about 6 hours per week. Heavier usage is reviewed with you at renewal.' },
  { q: 'How does creator pricing work?', a: 'Our fee covers sourcing, briefs, and management. Creator payments are separate and billed at cost.' },
  { q: 'What usage rights are included?', a: 'Organic use on your own channels is included. Paid usage and whitelisting are available for an added fee.' },
  { q: 'How many revisions do I get?', a: 'One revision round per creator video. Extra rounds are quoted per round.' },
  { q: 'How do I cancel?', a: "Cancel with 30 days' notice. We recommend a 3-month commitment for social media management plans, since results build over time. The Studio Pass has no minimum term. Everything is billed monthly in advance." },
  { q: 'Do you work in Spanish?', a: 'Yes. We create content and source creators in English and Spanish.' },
  { q: 'Are website builds included?', a: 'Landing pages are included in the Studio Pass. Full website builds are quoted per project.' },
  { q: 'Can you rush a request?', a: 'Yes. Creator work needed in under 7 days carries a rush fee.' },
  { q: 'When am I billed?', a: 'Monthly, in advance. Creator payments are collected before creators start.' },
  { q: 'What happens after I apply?', a: 'We reply within 48 hours to confirm fit and next steps.' },
];
const faqCols = [faqs.slice(0, 5), faqs.slice(5)];
---
<BaseLayout title={title} description={description} canonicalPath="/services/" currentPage="services">

  <!-- HEADER -->
  <section id="services-top" class="svc-hero" data-screen-label="Services">
    <div class="sec-inner">
      <header class="blog-index-header reveal">
        <h1 class="blog-index-headline">Flat monthly rates for <span class="gradient-text">premium content.</span></h1>
      </header>
      <nav class="svc-fit reveal reveal-d1" aria-label="Find your fit">
        {fit.map((f) => (
          <a href={f.href} class="svc-fit-link">
            <span class="svc-fit-text">
              <span class="svc-fit-label">{f.label}</span>
              <span class="svc-fit-line">{f.line}</span>
            </span>
            <span class="svc-fit-arrow" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- STUDIO PASS -->
  <!-- Full-bleed gradient: intro and requests graphic on the gradient, the offer in a white card -->
  <section id="pass" class="sec sp" data-screen-label="Studio Pass">
    <div class="sec-inner sp-cols">
      <div class="sp-left reveal">
        <h2 class="sec-h2">The Studio Pass</h2>
        <p class="sp-tagline">Your fractional digital team.</p>
        <p class="sp-sub">An on-demand digital strategist with the value of a senior hire and none of the commitment.</p>

        <div class="portal sp-portal" aria-hidden="true">
          <div class="portal-window">
            <div class="portal-head">
              <span class="portal-dots"><i></i><i></i><i></i></span>
              <span class="portal-title">Studio Pass requests</span>
            </div>
            {portalRows.map((r) => (
              <div class="portal-row">
                <span class="portal-row-title">{r.title}</span>
                <span class={`portal-pill portal-pill--${r.tone}`}>{r.status}</span>
              </div>
            ))}
          </div>
          <div class="portal-speed">
            <span class="portal-speed-label">Most delivered in</span>
            <span class="portal-speed-value">1-2 days</span>
          </div>
        </div>
      </div>

      <div class="sp-card reveal reveal-d1">
        <p class="sp-price"><span class="sp-price-num">$1,900</span><span class="sp-price-mo">/month</span></p>
        <p class="sp-label">What is included</p>
        <ul class="sp-checklist">
          {passIncludes.map((item) => (
            <li><svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>{item}</li>
          ))}
        </ul>
        <a href={BLOOM_FORM_URL} target="_blank" rel="noopener noreferrer" class="btn-white sp-card-cta">Apply for the Studio Pass<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </div>
  </section>

  <!-- SOCIAL MEDIA MANAGEMENT -->
  <section id="social" class="sec svc-social" data-screen-label="Social media management">
    <div class="sec-inner">
      <div class="reveal">
        <h2 class="sec-h2">Social media management.</h2>
        <p class="sec-intro">Best for brands that only need social media. Every plan includes strategy, a content calendar, consistent publishing, a monthly strategy check-in, and a monthly performance report. We recommend a 3-month commitment.</p>
      </div>
      <div class="svc-plans">
        {plans.map((p, i) => (
          <article class:list={['svc-plan reveal', i && `reveal-d${i}`, { 'is-featured': p.featured }]}>
            <h3 class="svc-plan-name">{p.name}</h3>
            <p class="svc-plan-price">{p.price}</p>
            <p class="svc-plan-per">per month</p>
            <ul class="svc-plan-features">
              {p.features.map((f) => (
                <li><svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>{f}</li>
              ))}
            </ul>
            <a href={BLOOM_FORM_URL} target="_blank" rel="noopener noreferrer" class:list={['svc-plan-cta', p.featured ? 'btn-grad' : 'btn-outline']}>Choose {p.name}<span class="sr-only"> (opens in a new tab)</span></a>
          </article>
        ))}
      </div>

      <div id="addons" class="svc-addons reveal">
        <p class="svc-label">Add-on for any plan</p>
        <div class="svc-addon-row">
          <div>
            <h3 class="svc-addon-name">Email bundle</h3>
            <p class="svc-addon-desc">Newsletters planned, written, and sent for you.</p>
          </div>
          <p class="svc-addon-price"><span class="svc-addon-from">Starting at</span> <span class="svc-addon-num">$250</span> <span class="svc-addon-mo">/month</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- UGC CREATORS -->
  <section id="campaigns" class="sec svc-ugc" data-screen-label="UGC creators">
    <div class="sec-inner svc-ugc-cols">
      <div class="svc-ugc-intro reveal">
        <h2 class="sec-h2">UGC creators for your next campaign.</h2>
        <p class="sec-intro">UGC means user-generated content: short videos from real creators who show your product the way a customer would. It gives your business relatable, one-of-a-kind ads.</p>

        <div class="svc-ugc-price">
          <div>
            <p class="svc-ugc-amount">From <span class="svc-ugc-num">$750</span> per campaign</p>
            <p class="svc-ugc-scope">3 creators, up to 9 videos</p>
          </div>
          <a href={BLOOM_FORM_URL} target="_blank" rel="noopener noreferrer" class="btn-grad">Plan a campaign<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
        <dl class="svc-ugc-terms">
          <div><dt>Creator payments</dt><dd>Billed at cost, separate from our fee.</dd></div>
          <div><dt>Larger campaigns</dt><dd>5 creators from $1,200.</dd></div>
        </dl>
      </div>

      <ol class="svc-steps reveal reveal-d1">
        {ugcSteps.map((s, i) => (
          <li class="svc-step">
            <span class="svc-step-num">{i + 1}</span>
            <h3 class="svc-step-title">{s.title}</h3>
            <p class="svc-step-desc">{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WEB AND SEO -->
  <section id="web" class="sec svc-web" data-screen-label="Web and SEO">
    <div class="sec-inner svc-web-cols">
      <div class="svc-web-intro reveal">
        <h2 class="sec-h2">Web and SEO.</h2>
        <p class="sec-intro">Websites built to convert and SEO content that gets found, in English and Spanish.</p>
        <a href={BLOOM_FORM_URL} target="_blank" rel="noopener noreferrer" class="btn-grad">Request a quote<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
      <div class="svc-web-panel reveal reveal-d1">
        {webRows.map((r) => (
          <div class="svc-web-row">
            <span class="svc-web-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={webIcons[r.icon]} /></span>
            <div class="svc-web-text">
              <h3 class="svc-web-title">{r.title}</h3>
              <p class="svc-web-desc">{r.desc}</p>
            </div>
            <span class:list={['svc-web-tag', { 'is-dark': r.dark }]}>{r.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="sec svc-faq" data-screen-label="FAQ">
    <div class="sec-inner">
      <h2 class="sec-h2 reveal">Questions.</h2>
      <div class="svc-faq-cols">
        {faqCols.map((col) => (
          <div class="svc-faq-col">
            {col.map((f) => (
              <div class="svc-faq-item reveal">
                <h3 class="svc-faq-q">{f.q}</h3>
                <p class="svc-faq-a">{f.a}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <ContactSection compact />
</BaseLayout>
