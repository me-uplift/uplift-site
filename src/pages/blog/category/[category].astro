---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts, getCategories } from '../../../lib/notion.js';
import { categoryStyle } from '../../../lib/categories.js';

export async function getStaticPaths() {
  const [posts, categories] = await Promise.all([getPublishedPosts(), getCategories()]);
  return categories.map((c) => ({
    params: { category: c.slug },
    props: {
      categoryName: c.name,
      posts: posts.filter((p) => p.categories.includes(c.name)),
    },
  }));
}

const { categoryName, posts } = Astro.props;

const title = `${categoryName} | Insights | Uplift Digital Studio`;
const description = `Posts filed under ${categoryName} on Uplift Digital Studio Insights.`;
---
<BaseLayout title={title} description={description} canonicalPath={`/blog/category/${Astro.params.category}/`} ogImage={posts[0]?.ogImage ?? posts[0]?.cover ?? '/assets/og-image.png'}>
  <section id="blog-index" data-screen-label="Insights Category">
    <div class="wrap blog-wrap">
      <header class="blog-index-header reveal">
        <a href="/blog/" class="post-back">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          All insights
        </a>
        <p class="blog-eyebrow">Category</p>
        <h1 class="blog-index-headline">{categoryName}</h1>
      </header>

      <div class="post-grid">
        {posts.map((post) => (
          <a class="post-card" href={`/blog/${post.slug}/`}>
            <div class="post-card-media">
              {post.cover
                ? <img src={post.cover} alt="" loading="lazy">
                : <span class="cover-fallback" style={categoryStyle(post.categories[0])}></span>}
            </div>
            <div class="post-card-body">
              {post.categories[0] && <span class="badge cat" style={categoryStyle(post.categories[0])}>{post.categories[0]}</span>}
              <h2 class="post-card-title">{post.title}</h2>
              {post.excerpt && <p class="post-card-desc">{post.excerpt}</p>}
              <p class="card-meta">
                {post.readingTime && <span>{post.readingTime} min read</span>}
              </p>
            </div>
          </a>
        ))}
      </div>
      {posts.length === 0 && <p class="blog-empty">No posts here yet</p>}
    </div>
  </section>
</BaseLayout>
