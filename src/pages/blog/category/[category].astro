---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts, getCategories, formatDate } from '../../../lib/notion.js';

export async function getStaticPaths() {
  const [posts, categories] = await Promise.all([getPublishedPosts(), getCategories()]);
  return categories.map((c) => ({
    params: { category: c.slug },
    props: {
      categoryName: c.name,
      posts: posts.filter((p) => p.categories.includes(c.name)),
    },
  }));
}

const { categoryName, posts } = Astro.props;

const title = `${categoryName} — Blog — Uplift Digital Studio`;
const description = `Posts filed under ${categoryName} on the Uplift Digital Studio blog.`;
---
<BaseLayout title={title} description={description} canonicalPath={`/blog/category/${Astro.params.category}/`} ogImage={posts[0]?.ogImage ?? posts[0]?.cover ?? '/assets/og-image.png'}>
  <section id="blog-index" data-screen-label="Blog Category">
    <div class="wrap">
      <div class="blog-index-header reveal">
        <a href="/blog/" class="post-back">&larr; Back to Blog</a>
        <p class="eyebrow">Category</p>
        <h1 class="blog-index-headline">{categoryName}</h1>
      </div>

      <div class="blog-grid">
        {posts.map((post, idx) => (
          <a class={`post-card reveal ${idx % 3 === 1 ? 'reveal-d1' : idx % 3 === 2 ? 'reveal-d2' : ''}`} href={`/blog/${post.slug}/`}>
            {post.cover && (
              <div class="post-card-media">
                <img src={post.cover} alt="" loading="lazy">
              </div>
            )}
            <div class="post-card-body">
              <div class="post-card-meta-row">
                {post.categories.length > 0 && <span class="post-category">{post.categories[0]}</span>}
                {post.readingTime && <span class="post-card-reading-time">{post.readingTime} min read</span>}
              </div>
              <h2 class="post-card-title">{post.title}</h2>
              {post.excerpt && <p class="post-card-desc">{post.excerpt}</p>}
              {post.date && <p class="post-card-date">{formatDate(post.date)}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
