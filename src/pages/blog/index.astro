---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import ContactSection from '../../components/ContactSection.astro';
import { getPublishedPosts, getFeaturedPosts } from '../../lib/notion.js';
import { CATEGORIES, categorySlug, categoryStyle } from '../../lib/categories.js';

// Magazine top: one lead post plus a short list beside it.
const SIDE_COUNT = 3;
const posts = await getPublishedPosts();
// Posts are already sorted newest first. Checked "Featured" posts go first (the newest
// one is the lead); any open spots are filled with the most recent remaining posts.
const checked = (await getFeaturedPosts()).slice(0, SIDE_COUNT + 1);
const [lead, ...side] = [...checked, ...posts.filter((p) => !checked.includes(p))].slice(0, SIDE_COUNT + 1);

const title = 'Insights | Uplift Digital Studio';
const description = 'Marketing insights for small brands that want consistency without a full team, from Uplift Digital Studio.';
---
<BaseLayout title={title} description={description} canonicalPath="/blog/" ogImage={posts[0]?.ogImage ?? posts[0]?.cover ?? '/assets/og-image.png'}>
  <section id="blog-index" data-screen-label="Insights">
    <div class="wrap blog-wrap">
      <header class="blog-index-header reveal">
        <h1 class="blog-index-headline">Marketing insights for small brands that want consistency.</h1>
      </header>

      {lead && (
        <div class="magazine">
          <a class="mag-lead reveal" href={`/blog/${lead.slug}/`}>
            <div class="mag-lead-media">
              {lead.cover
                ? <img src={lead.cover} alt="" loading="lazy">
                : <span class="cover-fallback" style={categoryStyle(lead.categories[0])}></span>}
            </div>
            <div class="mag-lead-body">
              <div class="featured-tags">
                {lead.featured && <span class="badge badge-featured">Featured</span>}
                {lead.categories[0] && <span class="badge cat" style={categoryStyle(lead.categories[0])}>{lead.categories[0]}</span>}
              </div>
              <h2 class="mag-lead-title">{lead.title}</h2>
              {lead.excerpt && <p class="mag-lead-excerpt">{lead.excerpt}</p>}
              <p class="card-meta">
                {lead.readingTime && <span>{lead.readingTime} min read</span>}
              </p>
            </div>
          </a>
          {side.length > 0 && (
            <ul class="mag-side reveal reveal-d1">
              {side.map((post) => (
                <li>
                  <a class="mag-item" href={`/blog/${post.slug}/`}>
                    <div class="mag-item-text">
                      <h3 class="mag-item-title">{post.title}</h3>
                      {post.excerpt && <p class="mag-item-excerpt">{post.excerpt}</p>}
                      <p class="card-meta">
                        {post.readingTime && <span>{post.readingTime} min read</span>}
                      </p>
                    </div>
                    <div class="mag-item-thumb">
                      {post.cover
                        ? <img src={post.cover} alt="" loading="lazy">
                        : <span class="cover-fallback" style={categoryStyle(post.categories[0])}></span>}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )}

      <NewsletterSignup
        variant="strip"
        title="Marketing Notes for Small Brands"
        sub="Subscribe to our newsletter."
      />

      <div class="filter-bar" role="group" aria-label="Filter posts by category">
        <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">All</button>
        {CATEGORIES.map((c) => (
          <button type="button" class="filter-chip filter-chip--cat" style={categoryStyle(c.name)} data-filter={c.slug} aria-pressed="false">{c.name}</button>
        ))}
      </div>

      <div class="post-grid" id="post-grid">
        {posts.map((post) => (
          <a class="post-card" href={`/blog/${post.slug}/`} data-categories={post.categories.map(categorySlug).join(' ')}>
            <div class="post-card-media">
              {post.cover
                ? <img src={post.cover} alt="" loading="lazy">
                : <span class="cover-fallback" style={categoryStyle(post.categories[0])}></span>}
            </div>
            <div class="post-card-body">
              {post.categories[0] && <span class="badge cat" style={categoryStyle(post.categories[0])}>{post.categories[0]}</span>}
              <h3 class="post-card-title">{post.title}</h3>
              {post.excerpt && <p class="post-card-desc">{post.excerpt}</p>}
              <p class="card-meta">
                {post.readingTime && <span>{post.readingTime} min read</span>}
              </p>
            </div>
          </a>
        ))}
      </div>
      <p class="blog-empty" id="blog-empty" role="status" hidden={posts.length > 0}>No posts here yet</p>
    </div>
  </section>

  <ContactSection />
</BaseLayout>

<script>
  // Category filter: a card matches when any of its categories is the selected one.
  // "All" always lists every post, including the ones shown in the magazine top.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-chip'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#post-grid .post-card'));
  const empty = document.getElementById('blog-empty');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      let shown = 0;
      cards.forEach((card) => {
        const match = filter === 'all' || (card.dataset.categories || '').split(' ').includes(filter!);
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });
</script>
