---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getFeaturedPosts, getCategories, getTags, formatDate, slugify } from '../../lib/notion.js';

const posts = await getPublishedPosts();
const featured = await getFeaturedPosts();
const categories = await getCategories();
const tags = await getTags();

const title = 'Blog — Uplift Digital Studio';
const description = 'Notes on social media strategy, content, and growth from Uplift Digital Studio.';
---
<BaseLayout title={title} description={description} canonicalPath="/blog/" ogImage={posts[0]?.ogImage ?? posts[0]?.cover ?? '/assets/og-image.png'}>
  <section id="blog-index" data-screen-label="Blog">
    <div class="wrap">
      <div class="blog-index-header reveal">
        <p class="eyebrow">Journal</p>
        <h1 class="blog-index-headline">Notes on building brands that show up.</h1>
      </div>

      {(categories.length > 0 || tags.length > 0) && (
        <div class="blog-taxonomy reveal">
          {categories.length > 0 && (
            <div class="blog-taxonomy-group">
              <span class="blog-taxonomy-label">Categories</span>
              <div class="blog-taxonomy-pills">
                {categories.map((c) => <a class="post-category" href={`/blog/category/${c.slug}/`}>{c.name}</a>)}
              </div>
            </div>
          )}
          {tags.length > 0 && (
            <div class="blog-taxonomy-group">
              <span class="blog-taxonomy-label">Tags</span>
              <div class="blog-taxonomy-pills">
                {tags.map((t) => <a class="post-tag" href={`/blog/tag/${t.slug}/`}>{t.name}</a>)}
              </div>
            </div>
          )}
        </div>
      )}

      {featured.length > 0 && (
        <div class="featured-section reveal">
          <p class="eyebrow featured-eyebrow">Featured</p>
          <div class="blog-grid featured-grid">
            {featured.map((post) => (
              <a class="post-card featured" href={`/blog/${post.slug}/`}>
                {post.cover && (
                  <div class="post-card-media">
                    <img src={post.cover} alt="" loading="lazy">
                  </div>
                )}
                <div class="post-card-body">
                  <div class="post-card-meta-row">
                    {post.categories.length > 0 && <span class="post-category">{post.categories[0]}</span>}
                    {post.readingTime && <span class="post-card-reading-time">{post.readingTime} min read</span>}
                  </div>
                  <h2 class="post-card-title">{post.title}</h2>
                  {post.excerpt && <p class="post-card-desc">{post.excerpt}</p>}
                  {post.date && <p class="post-card-date">{formatDate(post.date)}</p>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      {posts.length === 0 ? (
        <p class="blog-empty">New posts are on the way — check back soon.</p>
      ) : (
        <div class="blog-grid">
          {posts.map((post, idx) => (
            <a class={`post-card reveal ${idx % 3 === 1 ? 'reveal-d1' : idx % 3 === 2 ? 'reveal-d2' : ''}`} href={`/blog/${post.slug}/`}>
              {post.cover && (
                <div class="post-card-media">
                  <img src={post.cover} alt="" loading="lazy">
                </div>
              )}
              <div class="post-card-body">
                <div class="post-card-meta-row">
                  {post.categories.length > 0 && <span class="post-category">{post.categories[0]}</span>}
                  {post.readingTime && <span class="post-card-reading-time">{post.readingTime} min read</span>}
                </div>
                <h2 class="post-card-title">{post.title}</h2>
                {post.excerpt && <p class="post-card-desc">{post.excerpt}</p>}
                {post.date && <p class="post-card-date">{formatDate(post.date)}</p>}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
