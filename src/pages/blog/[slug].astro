---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import ContactSection from '../../components/ContactSection.astro';
import { getPublishedPosts, getPostBlocks, getRelatedPosts, renderBlocks, annotateHeadings, topHeadingLevel, formatDate, slugify } from '../../lib/notion.js';
import { categorySlug, categoryStyle } from '../../lib/categories.js';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const blocks = await getPostBlocks(post.id);

// Ids already on this page, so a heading can't take one (e.g. "Post" -> "post-2")
const PAGE_IDS = ['main', 'nav-menu', 'nav', 'nav-logo-link', 'nav-logo-img', 'nav-toggle', 'footer', 'post', 'toc-title', 'read-progress', 'post-newsletter-title', 'post-newsletter-email', 'related-title', 'contact'];
const headings = annotateHeadings(blocks, PAGE_IDS);

// Mid-article newsletter sign-up goes at the end of the first H2 section, i.e. right before
// the next H1/H2. Skipped when the post has fewer than two sections.
const isSectionHeading = (b) => b.type === 'heading_1' || b.type === 'heading_2';
const firstH2 = blocks.findIndex((b) => b.type === 'heading_2');
const ctaAt = firstH2 === -1 ? -1 : blocks.findIndex((b, i) => i > firstH2 && isSectionHeading(b));
// Both halves share the whole post's top heading level so the outline stays consistent
const topLevel = topHeadingLevel(blocks);
const bodyBefore = renderBlocks(ctaAt === -1 ? blocks : blocks.slice(0, ctaAt), topLevel);
const bodyAfter = ctaAt === -1 ? '' : renderBlocks(blocks.slice(ctaAt), topLevel);

const related = await getRelatedPosts(post, 3);
const initials = (post.author || '').split(/\s+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();

const pageTitle = post.seoTitle || `${post.title} | Uplift Digital Studio`;
const description = post.seoDescription || post.excerpt || `Read ${post.title} on the Uplift Digital Studio Insights.`;
const ogImage = post.ogImage || post.cover || '/assets/og-image.png';
const canonicalPath = `/blog/${post.slug}/`;
const pageUrl = new URL(canonicalPath, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description,
  ...(ogImage ? { image: [new URL(ogImage, Astro.site).toString()] } : {}),
  ...(post.date ? { datePublished: post.date } : {}),
  dateModified: post.updated || post.date,
  author: post.author
    ? { '@type': 'Person', name: post.author }
    : { '@type': 'Organization', name: 'Uplift Digital Studio' },
  publisher: {
    '@type': 'Organization',
    name: 'Uplift Digital Studio',
    logo: { '@type': 'ImageObject', url: new URL('/assets/UpliftLogo_GradientFixed.svg', Astro.site).toString() },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': post.canonicalUrl || pageUrl },
};
---
<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath={canonicalPath}
  canonicalURL={post.canonicalUrl}
  ogImage={ogImage}
  ogType="article"
  noindex={post.noindex}
  publishedTime={post.date}
  modifiedTime={post.updated || post.date}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="read-progress" id="read-progress" aria-hidden="true"></div>

  <article id="post" data-screen-label="Post">
    <header class="post-header">
      <a href="/blog/" class="post-back">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        All insights
      </a>

      {post.categories.length > 0 && (
        <div class="post-categories">
          {post.categories.map((c) => (
            <a class="badge cat" style={categoryStyle(c)} href={`/blog/category/${categorySlug(c)}/`}>{c}</a>
          ))}
        </div>
      )}

      <h1 class="post-title">{post.title}</h1>
      {post.excerpt && <p class="post-dek">{post.excerpt}</p>}

      <div class="post-byline">
        {initials && <span class="post-avatar" aria-hidden="true">{initials}</span>}
        <div class="post-byline-text">
          {post.author && <span class="post-author">{post.author}</span>}
          <span class="card-meta">
            {post.date && <time datetime={post.date}>{formatDate(post.date)}</time>}
            {post.readingTime && <span>{post.readingTime} min read</span>}
          </span>
        </div>
      </div>
    </header>

    {post.cover && (
      <div class="post-cover">
        <img src={post.cover} alt="">
      </div>
    )}

    <div class="post-body">
      <TableOfContents headings={headings} />
      <Fragment set:html={bodyBefore} />
      {bodyAfter && (
        <NewsletterSignup
          id="post-newsletter"
          variant="inline"
          title="Get more ideas like this in your inbox"
          sub="Practical marketing ideas for small brands, sent when we publish. Unsubscribe any time."
        />
      )}
      <Fragment set:html={bodyAfter} />

      {post.tags.length > 0 && (
        <div class="post-tags">
          {post.tags.map((t) => <a class="post-tag" href={`/blog/tag/${slugify(t)}/`}>{t}</a>)}
        </div>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <div class="wrap blog-wrap post-after">
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title" class="related-title">Keep Reading</h2>
        <div class="post-grid">
          {related.map((r) => (
            <a class="post-card" href={`/blog/${r.slug}/`}>
              <div class="post-card-media">
                {r.cover
                  ? <img src={r.cover} alt="" loading="lazy">
                  : <span class="cover-fallback" style={categoryStyle(r.categories[0])}></span>}
              </div>
              <div class="post-card-body">
                {r.categories[0] && <span class="badge cat" style={categoryStyle(r.categories[0])}>{r.categories[0]}</span>}
                <h3 class="post-card-title">{r.title}</h3>
                <p class="card-meta">
                  {r.readingTime && <span>{r.readingTime} min read</span>}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  )}

  <ContactSection />

  <script>
    // Reading progress: 0 when the article body reaches the nav, 100 when its end reaches the bottom of the screen
    (function () {
      const bar = document.getElementById('read-progress');
      const body = document.querySelector('.post-body');
      if (!bar || !body) return;
      const NAV_H = 64;
      let start = 0;
      let end = 1;
      let ticking = false;

      function measure() {
        const r = body.getBoundingClientRect();
        start = r.top + window.scrollY - NAV_H;
        end = r.bottom + window.scrollY - window.innerHeight;
        paint();
      }
      function paint() {
        ticking = false;
        const p = end > start ? (window.scrollY - start) / (end - start) : 1;
        bar.style.setProperty('--progress', String(Math.min(Math.max(p, 0), 1)));
      }

      window.addEventListener('scroll', () => {
        if (!ticking) { ticking = true; requestAnimationFrame(paint); }
      }, { passive: true });
      window.addEventListener('resize', measure);
      window.addEventListener('load', measure); // images change the article height
      measure();
    })();
  </script>
</BaseLayout>
