---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getPostBlocks, renderBlocks, formatDate, slugify } from '../../lib/notion.js';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const blocks = await getPostBlocks(post.id);
const contentHtml = renderBlocks(blocks);

const pageTitle = post.seoTitle || `${post.title} — Uplift Digital Studio`;
const description = post.seoDescription || post.excerpt || `Read ${post.title} on the Uplift Digital Studio blog.`;
const ogImage = post.ogImage || post.cover || '/assets/og-image.png';
const canonicalPath = `/blog/${post.slug}/`;
const pageUrl = new URL(canonicalPath, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description,
  ...(ogImage ? { image: [new URL(ogImage, Astro.site).toString()] } : {}),
  ...(post.date ? { datePublished: post.date } : {}),
  dateModified: post.updated || post.date,
  author: post.author
    ? { '@type': 'Person', name: post.author }
    : { '@type': 'Organization', name: 'Uplift Digital Studio' },
  publisher: {
    '@type': 'Organization',
    name: 'Uplift Digital Studio',
    logo: { '@type': 'ImageObject', url: new URL('/assets/UpliftLogo_GradientFixed.svg', Astro.site).toString() },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': post.canonicalUrl || pageUrl },
};
---
<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath={canonicalPath}
  canonicalURL={post.canonicalUrl}
  ogImage={ogImage}
  ogType="article"
  noindex={post.noindex}
  publishedTime={post.date}
  modifiedTime={post.updated || post.date}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article id="post" data-screen-label="Post">
    <div class="wrap post-wrap">
      <a href="/blog/" class="post-back">&larr; Back to Blog</a>

      {post.categories.length > 0 && (
        <div class="post-categories">
          {post.categories.map((c) => (
            <a class="post-category" href={`/blog/category/${slugify(c)}/`}>{c}</a>
          ))}
        </div>
      )}

      <h1 class="post-title reveal">{post.title}</h1>

      <div class="post-meta">
        {post.author && <span class="post-byline">By {post.author}</span>}
        {post.date && <span class="post-date">{formatDate(post.date)}</span>}
        {post.readingTime && <span class="post-reading-time">{post.readingTime} min read</span>}
      </div>

      {post.tags.length > 0 && (
        <div class="post-tags">
          {post.tags.map((t) => <a class="post-tag" href={`/blog/tag/${slugify(t)}/`}>{t}</a>)}
        </div>
      )}

      {post.cover && (
        <div class="post-cover reveal">
          <img src={post.cover} alt="">
        </div>
      )}

      <div class="post-body" set:html={contentHtml} />
    </div>
  </article>
</BaseLayout>
