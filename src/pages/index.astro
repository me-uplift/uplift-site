---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import { BLOOM_FORM_URL } from '../lib/links.js';

const title = 'Uplift Digital Studio — Premium Social Media Management';
const description = "Uplift Digital Studio is a bilingual social media management and UGC agency for premium brands. Done-for-you content strategy, community management, and creator-led content in English and Spanish.";

// Hero collage: placeholder copy for the four deliverable cards. Edit here.
const heroCards = {
  brand: 'futureyou',
  landing: { url: 'futureyou.com', heading: 'Meet the brand people remember.', cta: 'Get started' },
  post: { image: 'Made to be noticed.', caption: 'Fall launch, week 1.' },
  email: { subject: 'Your October newsletter', time: '9:02 AM', cta: 'Shop the drop' },
  analytics: { label: 'Reach · last 30 days', value: '+42%', spark: [30, 26, 28, 20, 23, 16, 18, 9, 12, 4] },
};
// About section portraits. If a photo is missing, the lavender placeholder shows instead.
const team = [
  { name: 'Mya Williams', role: 'Founder & Creative Strategist', photo: '/assets/mya-williams.webp' },
  { name: 'Jesús Valenzuela', role: 'Bilingual SEO & Content Lead', photo: '/assets/jesus-valenzuela.webp' },
];
const sparkPoints = heroCards.analytics.spark
  .map((y, i, a) => `${(i / (a.length - 1)) * 120},${y}`)
  .join(' ');

// Service words on the arch
const archWords = [
  { label: 'Strategy & Ops', href: '#studio-pass' },
  { label: 'Social', href: '/services/#social' },
  { label: 'Email', href: '/services/#addons' },
  { label: 'Web & SEO', href: '/services/#web' },
  { label: 'UGC Creators', href: '/services/#campaigns' },
];

// Studio Pass request list
const passRequests = [
  'Social media content', 'Email campaigns', 'Landing pages', 'SEO',
  'UGC creators', 'Copywriting', 'Campaign planning', 'Project management',
];

// More ways to work with us
const offers = [
  {
    label: 'Social media management',
    title: 'Strategy, content, and publishing for your channels.',
    desc: 'Consistent posting and a monthly performance report, handled by one team. Add email newsletters, written and sent for you, to any plan.',
    link: 'See plans', href: '/services/#social', art: 'social',
  },
  {
    label: 'Creator sourcing', isNew: true,
    title: 'UGC creators for your campaigns.',
    desc: 'Vetted creators, briefed and managed by us. You receive ready-to-post content.',
    link: 'See campaigns', href: '/services/#campaigns', art: 'creators',
  },
  {
    label: 'Web & SEO',
    title: 'Websites and search that bring buyers to you.',
    desc: 'Websites built to convert and SEO content that gets found, in English and Spanish.',
    link: 'See web and SEO', href: '/services/#web', art: 'web',
  },
];
---
<BaseLayout title={title} description={description} canonicalPath="/" ogImage="/assets/og-image.png" transparentNav={true}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Space+Grotesk:wght@500&display=swap">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Uplift Digital Studio",
      "legalName": "MyaEliza LLC",
      "url": "https://upliftdigital.studio/",
      "logo": "https://upliftdigital.studio/assets/UpliftLogo_GradientFixed.svg",
      "image": "https://upliftdigital.studio/assets/og-image.png",
      "description": "Bilingual social media management and UGC agency for premium brands. Content strategy, community management, and creator-led content production.",
      "email": "hello@upliftdigital.studio",
      "sameAs": ["https://www.linkedin.com/company/uplift-digital-studio/"],
      "availableLanguage": ["en", "es"],
      "areaServed": ["United States", "Latin America"],
      "serviceType": ["Social Media Management", "User-Generated Content", "Content Strategy", "Community Management"]
    })} />
  </Fragment>

  <!-- HERO -->
  <section id="hero" data-screen-label="Hero">
    <div class="hero-stage">
      <div class="wrap hero-inner">
        <div class="hero-frame">
        <div class="hero-copy">
          <h1 class="hero-headline reveal reveal-d1">Premium content for brands that refuse to blend in.</h1>
          <p class="hero-sub reveal reveal-d2">Strategy, content, and publishing from one senior team, on a flat monthly rate with no long-term commitment.</p>
          <div class="hero-actions reveal reveal-d3">
            <a href="#studio-pass" class="btn btn-light">Apply for the Studio Pass</a>
            <a href="/services/" class="hero-link-secondary">See plans</a>
          </div>
        </div>

        <div class="hero-collage" aria-hidden="true">
          <div class="hc hc-landing" style="--i:0">
            <div class="hc-browser"><i></i><i></i><i></i><span class="hc-url">{heroCards.landing.url}</span></div>
            <div class="hc-landing-body">
              <div class="hc-landing-nav"><span class="hc-logo"></span><span class="hc-links"><i></i><i></i></span></div>
              <p class="hc-landing-h">{heroCards.landing.heading}</p>
              <span class="hc-bar hc-bar-wide"></span>
              <span class="hc-pill">{heroCards.landing.cta}</span>
              <div class="hc-landing-block"></div>
            </div>
          </div>

          <div class="hc hc-email" style="--i:1">
            <p class="hc-email-subject">{heroCards.email.subject}</p>
            <p class="hc-email-from">From {heroCards.brand} · {heroCards.email.time}</p>
            <div class="hc-email-banner"></div>
            <span class="hc-bar"></span>
            <span class="hc-bar"></span>
            <span class="hc-bar hc-bar-short"></span>
            <span class="hc-pill">{heroCards.email.cta}</span>
          </div>

          <div class="hc hc-post" style="--i:2">
            <div class="hc-post-head"><span class="hc-avatar"></span>{heroCards.brand}</div>
            <div class="hc-post-img"><span>{heroCards.post.image}</span></div>
            <div class="hc-post-icons">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            </div>
            <p class="hc-post-caption"><b>{heroCards.brand}</b> {heroCards.post.caption}</p>
          </div>

          <div class="hc hc-stats" style="--i:3">
            <p class="hc-stats-label">{heroCards.analytics.label}</p>
            <p class="hc-stats-value">{heroCards.analytics.value}</p>
            <svg class="hc-spark" viewBox="-2 0 124 34" preserveAspectRatio="none">
              <defs>
                <linearGradient id="hc-spark-grad" x1="0" x2="1" y1="0" y2="0">
                  <stop offset="0" stop-color="#e9967a" />
                  <stop offset="1" stop-color="#6f6bc2" />
                </linearGradient>
              </defs>
              <polyline points={sparkPoints} fill="none" stroke="url(#hc-spark-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
            </svg>
          </div>
        </div>
        </div>
      </div>

      <svg class="hero-arch" viewBox="0 0 1440 160" preserveAspectRatio="none" role="group" aria-label="Services">
        <defs>
          <filter id="arch-shadow" x="-5%" y="-100%" width="110%" height="250%">
            <feDropShadow id="arch-shadow-drop" dx="0" dy="-4" stdDeviation="14" flood-color="#1e103c" flood-opacity="0" />
          </filter>
          <path id="hero-arch-text" d="M0 192 Q 720 -22 1440 192" />
          <!-- hover/focus fill; x1/x2 are fitted to the active word by script -->
          <linearGradient id="arch-word-grad" gradientUnits="userSpaceOnUse" x1="360" y1="0" x2="1080" y2="0">
            <stop offset="0" stop-color="#b0546a" />
            <stop offset="1" stop-color="#7a4fb0" />
          </linearGradient>
        </defs>
        <path id="arch-fill" class="hero-arch-fill" filter="url(#arch-shadow)" d="M0 150 Q 720 -60 1440 150 L1440 160 L0 160 Z" />
        <path id="arch-line" class="hero-arch-line" d="M0 150 Q 720 -60 1440 150" />
        <text class="hero-arch-words" text-anchor="middle">
          <textPath href="#hero-arch-text" startOffset="50%">
            {archWords.map((w, i) => (
              <Fragment>
                {i > 0 && <tspan class="arch-sep" aria-hidden="true"> · </tspan>}
                <a href={w.href} class="arch-link"><tspan class="arch-word" style={`--w:${i}`}>{w.label}</tspan></a>
              </Fragment>
            ))}
          </textPath>
        </text>
        <rect id="arch-focus-ring" class="arch-ring" rx="12" />
      </svg>
    </div>

    <ul class="hero-words-m" aria-label="Services">
      {archWords.map((w, i) => (
        <li>
          {i > 0 && <span class="arch-sep" aria-hidden="true">·</span>}
          <a href={w.href} class="arch-word" style={`--w:${i}`}>{w.label}</a>
        </li>
      ))}
    </ul>
  </section>

  <!-- VALUE -->
  <section id="what" data-screen-label="Value">
    <div class="wrap">
      <div class="what-header reveal">
        <h2 class="what-headline">Content with a plan behind it.</h2>
        <p class="what-sub">You work directly with the senior team behind your content. We learn your brand inside out, then plan, create, and manage everything around your goals.</p>
      </div>
      <div class="what-grid">
        <div class="what-item reveal">
          <div class="what-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg></div>
          <h3 class="what-title">Be seen</h3>
          <p class="what-desc">Social and SEO that put you in front of the right people.</p>
        </div>
        <div class="what-item reveal reveal-d1">
          <div class="what-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg></div>
          <h3 class="what-title">Be understood</h3>
          <p class="what-desc">Strategy and copy in your audience's own language.</p>
        </div>
        <div class="what-item reveal reveal-d2">
          <div class="what-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg></div>
          <h3 class="what-title">Be chosen</h3>
          <p class="what-desc">Websites and email built to convert.</p>
        </div>
        <div class="what-item reveal reveal-d3">
          <div class="what-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></div>
          <h3 class="what-title">Be remembered</h3>
          <p class="what-desc">UGC and community that build loyalty.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STUDIO PASS -->
  <!-- Older links pointed to #pass and #studio -->
  <div id="pass" class="anchor-alias" aria-hidden="true"></div>
  <div id="studio" class="anchor-alias" aria-hidden="true"></div>
  <section id="studio-pass" class="sec sp" data-screen-label="Studio Pass">
    <div class="sec-inner sp-cols">
      <div class="sp-left reveal">
        <h2 class="sec-h2">The Studio Pass</h2>
        <p class="sp-tagline">Your fractional digital team.</p>
        <p class="sp-price"><span class="sp-price-num">$1,900</span><span class="sp-price-mo">/month</span></p>
        <p class="sp-sub">An on-demand digital strategist with the value of a senior hire and none of the commitment.</p>
        <div class="sp-actions">
          <a href={BLOOM_FORM_URL} target="_blank" rel="noopener noreferrer" class="btn btn-light">Apply for the Studio Pass<span class="sr-only"> (opens in a new tab)</span></a>
          <a href="/services/#pass" class="sp-link">See pricing</a>
        </div>
        <p class="sp-note">No long-term commitment, cancel with 30 days' notice.</p>
      </div>
      <div class="sp-right reveal reveal-d1">
        <p class="sp-label">Send us anything from this list</p>
        <ul class="sp-tiles">
          {passRequests.map((r) => (
            <li><svg class="check-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>{r}</li>
          ))}
        </ul>
        <p class="sp-how">Subscribe, add requests, and receive your work in 1-2 business days. We work through requests one at a time, in priority order, with revisions included.</p>
      </div>
    </div>
  </section>

  <!-- MORE WAYS TO WORK WITH US -->
  <!-- Older links pointed to #plans -->
  <div id="plans" class="anchor-alias" aria-hidden="true"></div>
  <section id="offers" class="sec offers" data-screen-label="Offers">
    <div class="sec-inner">
      <div class="offers-head reveal">
        <h2 class="sec-h2">More ways to work with us.</h2>
        <p class="sec-intro">Bring us in for social media management, creator sourcing, or web and SEO as a single service.</p>
      </div>
      <div class="offers-grid">
        {offers.map((o, i) => (
          <article class={`offer-card reveal${i ? ` reveal-d${i}` : ''}`}>
            <div class={`oa oa-${o.art}`} aria-hidden="true">
              {o.art === 'social' && (
                <Fragment>
                  <div class="oa-card oa-post">
                    <div class="oa-post-img"></div>
                    <div class="oa-post-row">
                      <svg class="oa-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                      <span class="oa-bar"></span>
                    </div>
                    <span class="oa-bar oa-post-bar"></span>
                  </div>
                  <div class="oa-card oa-email">
                    <div class="oa-email-head">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                      <span>Your October newsletter</span>
                    </div>
                    <div class="oa-email-banner"></div>
                    <span class="oa-bar oa-email-bar1"></span>
                    <span class="oa-bar oa-email-bar2"></span>
                    <span class="oa-email-pill"></span>
                  </div>
                </Fragment>
              )}
              {o.art === 'creators' && (
                <Fragment>
                  <div class="oa-card oa-thumb oa-thumb-1"><span class="oa-play"></span></div>
                  <div class="oa-card oa-thumb oa-thumb-2"><span class="oa-play"></span></div>
                  <div class="oa-card oa-chip">
                    <span class="oa-avatar"></span>
                    <span class="oa-chip-lines"><span class="oa-bar"></span><span class="oa-bar"></span></span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                  </div>
                </Fragment>
              )}
              {o.art === 'web' && (
                <Fragment>
                  <div class="oa-card oa-browser">
                    <span class="oa-dots"><i></i><i></i><i></i></span>
                    <span class="oa-bar oa-bar-dark"></span>
                    <span class="oa-bar oa-w90"></span>
                    <span class="oa-bar oa-w60"></span>
                    <span class="oa-pill"></span>
                  </div>
                  <div class="oa-card oa-search">
                    <span class="oa-field">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                      <span class="oa-bar"></span>
                    </span>
                    <span class="oa-bar oa-bar-purple"></span>
                    <span class="oa-bar oa-w92"></span>
                  </div>
                </Fragment>
              )}
            </div>
            <h3 class="offer-label">{o.label}{o.isNew && <span class="offer-new">New</span>}</h3>
            <p class="offer-title">{o.title}</p>
            <p class="offer-desc">{o.desc}</p>
            <a href={o.href} class="offer-link">{o.link}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
          </article>
        ))}
      </div>
      <div class="offers-cta reveal">
        <a href="/services/" class="btn btn-dark">See full pricing</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="team" data-screen-label="About">
    <div class="wrap">
      <div class="team-header reveal">
        <h2 class="team-headline">About us.</h2>
        <p class="team-sub">Uplift Digital Studio is built on a simple idea: premium content should feel personal. That's why we're with you from first idea to launch day and beyond.</p>
      </div>
      <div class="team-grid">
        {team.map((member, i) => (
          <article class={`team-member reveal${i ? ` reveal-d${i}` : ''}`}>
            <div class="team-photo">
              <img src={member.photo} alt={`Portrait of ${member.name}`} width="640" height="800" loading="lazy" decoding="async" onerror="this.remove()">
            </div>
            <h3 class="team-name">{member.name}</h3>
            <p class="team-role">{member.role}</p>
          </article>
        ))}
      </div>
      <p class="team-join reveal">Join our team. Send your resume to <a href="mailto:hello@upliftdigital.studio">hello@upliftdigital.studio</a>.</p>
    </div>
  </section>

  <!-- CONTACT -->
  <ContactSection />

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Hero arch flattens as the hero scrolls away; the words' path straightens with it
    (function () {
      const stage = document.querySelector('.hero-stage');
      const fill = document.getElementById('arch-fill');
      const line = document.getElementById('arch-line');
      const text = document.getElementById('hero-arch-text');
      if (!stage || !fill || !line || !text || reduceMotion) return;

      const shadow = document.getElementById('arch-shadow-drop');
      // End state: a straight line at y=118 with the words' baseline straight at y=148,
      // which keeps the words below the line and inside the hero edge throughout
      const LINE_END = 118;
      const TEXT_END = 148;
      let lastE = 0;
      let ticking = false;

      function update() {
        ticking = false;
        const p = Math.min(Math.max(window.scrollY / (stage.offsetHeight * 0.6), 0), 1);
        const e = Math.round(p * p * (3 - 2 * p) * 1000) / 1000;
        if (e === lastE) return;
        lastE = e;
        const y = 150 + (LINE_END - 150) * e;   // arch ends
        const c = -60 + (LINE_END + 60) * e;    // arch control point
        const ty = 192 + (TEXT_END - 192) * e;  // text path ends
        const t = -22 + (TEXT_END + 22) * e;    // text path control point
        fill.setAttribute('d', `M0 ${y} Q 720 ${c} 1440 ${y} L1440 160 L0 160 Z`);
        line.setAttribute('d', `M0 ${y} Q 720 ${c} 1440 ${y}`);
        text.setAttribute('d', `M0 ${ty} Q 720 ${t} 1440 ${ty}`);
        // Shadow fades in late, so the white band reads as lifted above the hero
        if (shadow) shadow.setAttribute('flood-opacity', (0.2 * e * e).toFixed(3));
      }

      window.addEventListener('scroll', () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();
    })();

    // Arch words: fit the hover gradient to the active word, and draw a focus ring
    // around it for keyboard users (SVG text inside a link gets no native outline)
    (function () {
      const grad = document.getElementById('arch-word-grad');
      const ring = document.getElementById('arch-focus-ring');
      if (!grad || !ring) return;
      let focused = null;

      function fit(word) {
        const b = word.getBBox();
        grad.setAttribute('x1', b.x);
        grad.setAttribute('x2', b.x + b.width);
        return b;
      }
      function placeRing() {
        if (!focused) return;
        const b = fit(focused);
        ring.setAttribute('x', b.x - 7);
        ring.setAttribute('y', b.y - 2);
        ring.setAttribute('width', b.width + 14);
        ring.setAttribute('height', b.height + 4);
      }

      document.querySelectorAll('.hero-arch .arch-link').forEach(a => {
        const word = a.querySelector('.arch-word');
        a.addEventListener('pointerenter', () => fit(word));
        a.addEventListener('focus', () => {
          if (!a.matches(':focus-visible')) return;
          focused = word;
          placeRing();
          ring.classList.add('is-on');
        });
        a.addEventListener('blur', () => {
          focused = null;
          ring.classList.remove('is-on');
        });
      });
      // The words move as the arch flattens, so keep the ring on its word
      window.addEventListener('scroll', () => {
        if (focused) requestAnimationFrame(placeRing);
      }, { passive: true });
    })();
  </script>
</BaseLayout>
