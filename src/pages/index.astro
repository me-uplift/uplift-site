---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Uplift Digital Studio — Premium Social Media Management';
const description = "Uplift Digital Studio is a bilingual social media management and UGC agency for premium brands. Done-for-you content strategy, community management, and creator-led content in English and Spanish.";
---
<BaseLayout title={title} description={description} canonicalPath="/" ogImage="/assets/og-image.png" transparentNav={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Uplift Digital Studio",
      "legalName": "MyaEliza LLC",
      "url": "https://upliftdigital.studio/",
      "logo": "https://upliftdigital.studio/assets/UpliftLogo_GradientFixed.svg",
      "image": "https://upliftdigital.studio/assets/og-image.png",
      "description": "Bilingual social media management and UGC agency for premium brands. Content strategy, community management, and creator-led content production.",
      "email": "hello@upliftdigital.studio",
      "sameAs": ["https://www.linkedin.com/company/uplift-digital-studio/"],
      "availableLanguage": ["en", "es"],
      "areaServed": ["United States", "Latin America"],
      "serviceType": ["Social Media Management", "User-Generated Content", "Content Strategy", "Community Management"]
    })} />
  </Fragment>

  <!-- HERO -->
  <section id="hero" data-screen-label="Hero">
    <div class="hero-copy">
      <h1 class="hero-headline reveal reveal-d1">Premium content for brands that refuse to blend in.</h1>
      <p class="hero-sub reveal reveal-d2">Strategy, content, and publishing from one senior team, on a flat monthly rate with no long-term contract.</p>
      <div class="hero-actions reveal reveal-d3">
        <a href="#plans" class="btn-grad">See plans</a>
        <a href="#pass" class="btn-outline hero-btn-outline">Apply for the Studio Pass</a>
      </div>
    </div>
    <div class="hero-panel">
      <div class="hero-panel-bg" aria-hidden="true"></div>
      <ul class="hero-words reveal reveal-d2">
        <li>Social media</li>
        <li>Email</li>
        <li>Websites</li>
        <li>SEO</li>
        <li>UGC</li>
      </ul>
      <p class="hero-panel-caption reveal reveal-d3">Start with a social media plan or get a fractional digital team with the Studio Pass.</p>
    </div>
  </section>

  <!-- PLANS -->
  <section id="plans" data-screen-label="Plans">
    <div class="wrap">
      <div class="plans-header reveal">
        <h2 class="plans-headline">Social media plans.</h2>
        <p class="plans-sub">Best for social media only. Every plan includes strategy, content, and consistent publishing, with an email bundle add-on available.</p>
      </div>
      <div class="plans-dots" id="plans-dots" aria-hidden="true"></div>
      <div class="plans-grid">

        <div class="plan-card reveal">
          <div class="plan-label">Essentials</div>
          <div class="plan-price">$600</div>
          <div class="plan-price-sub">per month</div>
          <div class="plan-divider"></div>
          <p class="plan-desc">Consistent, strategic social presence on one platform, done for you.</p>
          <div class="plan-features">
            <div class="plan-feature">9 posts and 9 stories</div>
            <div class="plan-feature">1 platform</div>
            <div class="plan-feature">Caption writing</div>
            <div class="plan-feature">Content calendar and scheduling</div>
            <div class="plan-feature">Monthly strategy check-in</div>
            <div class="plan-feature">Monthly performance report</div>
          </div>
          <p class="plan-addons-note">Add-ons: Email bundle $250</p>
          <a href="mailto:hello@upliftdigital.studio" class="btn-outline">Get started</a>
        </div>

        <div class="plan-card featured reveal reveal-d1">
          <div class="plan-label">Growth <span class="plan-badge">Most popular</span></div>
          <div class="plan-price">$800</div>
          <div class="plan-price-sub">per month</div>
          <div class="plan-divider"></div>
          <p class="plan-desc">Expanded presence across two platforms with engagement management included.</p>
          <div class="plan-features">
            <div class="plan-feature">Everything in Essentials</div>
            <div class="plan-feature">16 posts and 16 stories</div>
            <div class="plan-feature">2 platforms</div>
            <div class="plan-feature">Comment-triggered DM automation (Instagram/Facebook)</div>
          </div>
          <p class="plan-addons-note">Add-ons: Email bundle $250</p>
          <a href="mailto:hello@upliftdigital.studio" class="btn-outline">Get started</a>
        </div>

        <div class="plan-card reveal reveal-d2">
          <div class="plan-label">Full Digital</div>
          <div class="plan-price">$1,100</div>
          <div class="plan-price-sub">per month</div>
          <div class="plan-divider"></div>
          <p class="plan-desc">Full-service social management with proactive community growth, built for scale.</p>
          <div class="plan-features">
            <div class="plan-feature">Everything in Growth</div>
            <div class="plan-feature">20 posts and 20 stories</div>
            <div class="plan-feature">Live engagement management for DMs and comments</div>
            <div class="plan-feature">Monthly Growth Guide: curated accounts, hashtags, and outreach talking points for visibility</div>
            <div class="plan-feature">Priority communication</div>
          </div>
          <p class="plan-addons-note">Add-ons: Email bundle $250</p>
          <a href="mailto:hello@upliftdigital.studio" class="btn-outline">Get started</a>
        </div>

      </div>
    </div>
  </section>

  <!-- STUDIO PASS -->
  <section id="pass" data-screen-label="Studio Pass">
    <div class="pass-bg"></div>
    <div class="wrap pass-content">
      <div class="pass-layout">
      <div class="pass-intro">
      <div class="pass-header">
        <h2 class="pass-headline reveal reveal-d1">The Studio Pass</h2>
        <p class="pass-tagline reveal reveal-d2">Your fractional digital team.</p>
        <p class="pass-more reveal reveal-d2">Need more than social media? Send us any request.</p>
        <p class="pass-sub reveal reveal-d2">An on-demand digital strategist for everything your brand needs built, with the value of a senior hire and none of the commitment.</p>
      </div>

      <div class="pass-steps">
        <div class="pass-step reveal">
          <div class="pass-step-num">01</div>
          <h3 class="pass-step-title">Subscribe</h3>
          <p class="pass-step-desc">Subscribe to the Studio Pass and request as many projects as you'd like.</p>
        </div>
        <div class="pass-step reveal reveal-d1">
          <div class="pass-step-num">02</div>
          <h3 class="pass-step-title">Add requests</h3>
          <p class="pass-step-desc">We work through your requests one at a time, in priority order.</p>
        </div>
        <div class="pass-step reveal reveal-d2">
          <div class="pass-step-num">03</div>
          <h3 class="pass-step-title">Receive your work</h3>
          <p class="pass-step-desc">Get deliverables in 48 hours on average, revised until you're 100% happy.</p>
        </div>
      </div>
      </div>

      <div class="pass-card reveal reveal-d2">
        <div class="pass-benefits">

          <div class="pass-price-block">
            <div class="pass-price">$1,900</div>
            <div class="pass-price-mo">/month</div>
          </div>
          <ul class="pass-list">
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>Unlimited requests</li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>48-hour average turnaround</li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>Social, email, web, SEO, and UGC</li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>Strategy, copywriting, and campaign planning</li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>Operations and project management as needed</li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="m9 11 3 3L22 4"></path></svg>No long-term contracts, cancel anytime</li>
          </ul>
          <a href="mailto:hello@upliftdigital.studio" class="btn-grad full">Apply for the Studio Pass</a>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" data-screen-label="Contact">
    <div class="wrap">
      <div class="contact-close">
        <h2 class="contact-headline reveal reveal-d1">Ready to grow?</h2>
        <p class="contact-sub reveal reveal-d2">Tell us about your brand and we'll be in touch soon.</p>
        <a href="mailto:hello@upliftdigital.studio" class="contact-email reveal reveal-d3">hello@upliftdigital.studio</a>
        <p class="contact-meta reveal reveal-d3">Thanks for your business · English + Spanish · USA, Latin America &amp; beyond</p>
      </div>
    </div>
  </section>
</BaseLayout>
